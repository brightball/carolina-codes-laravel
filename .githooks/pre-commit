#!/usr/bin/env bash
# In-repo pre-commit entry. Prefer the pre-commit runner so named hooks
# match .pre-commit-config.yaml; fall back to the same five commands.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:${PATH}"
if command -v mise >/dev/null 2>&1; then
  eval "$(mise hook-env -s bash 2>/dev/null || true)"
fi
if command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit run --hook-stage pre-commit --all-files
fi
php artisan test
vendor/bin/psalm --taint-analysis --no-cache --memory-limit=1G
composer audit --locked
gitleaks detect --source .
vendor/bin/pint --test
